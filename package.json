{
  "name": "graphpaper",
  "private": true,
  "version": "0.0.0",
  "description": "A spatial canvas where every object is a live node in one shared dependency graph.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json",
    "test": "vitest run",
    "prose": "node tools/prose-check.mjs --all"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
